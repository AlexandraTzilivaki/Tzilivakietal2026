proc setpositions(){ local gid, i, x, y
  for i=0,cells.count-1{
  if (i<Nx) {  // aleka. 
		gid=gidvec.x[i]
		if (gid>=iPC && gid<iCA3){
		x=X.x[i]
		y=Y.x[i]
 		z=Z.x[i]
		cells.object(i).position(x,y,z)
		
		
  
  }
 
 } //IF
}
}





