func round () {
  if ($1-int($1) >= 0.5) {
    return int($1)+1
  } else {
    return int($1)
  }
}

func ceiling () {   //ceiling is used for calculating the amount of PV subtypes. 
  if ($1-int($1) != 0) {
    return int($1)+1
  } else {
    return int($1)
  }
}

func flooring () {
  if ($1-int($1) != 0) {
    return int($1)-1
  } else {
    return int($1)
  }
}

